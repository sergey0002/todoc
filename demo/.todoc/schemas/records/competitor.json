{
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "name",
    "category",
    "portability"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^competitor:[a-z0-9][a-z0-9-]*$"
    },
    "entity_type": {
      "const": "competitor"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "enum": [
        "vault-app",
        "cli",
        "mcp-server",
        "agent-skill",
        "rag-platform",
        "llm-wiki"
      ]
    },
    "portability": {
      "enum": [
        "files-only",
        "mostly-portable",
        "vendor-lock"
      ]
    },
    "verdict": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "relations": {
      "type": "array"
    }
  }
}
