{
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "title",
    "audience",
    "postulates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^guide:[a-z0-9][a-z0-9-]*$"
    },
    "entity_type": {
      "const": "guide"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "audience": {
      "enum": [
        "ai-agent",
        "human",
        "both"
      ]
    },
    "postulates": {
      "type": "integer",
      "minimum": 0
    },
    "checklist": {
      "type": "boolean"
    },
    "source_path": {
      "type": "string"
    },
    "relations": {
      "type": "array"
    }
  }
}
