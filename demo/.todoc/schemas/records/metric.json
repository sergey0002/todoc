{
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "name",
    "aspect",
    "value"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^metric:[a-z0-9][a-z0-9-]*$"
    },
    "entity_type": {
      "const": "metric"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "aspect": {
      "enum": [
        "code",
        "tests",
        "docs",
        "cli",
        "types",
        "benchmark",
        "performance"
      ]
    },
    "value": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "string"
    }
  }
}
