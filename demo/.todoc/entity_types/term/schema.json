{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "record_id", "entity_type", "title", "term_type", "definition"],
  "properties": {
    "schema_version": { "const": 1 },

    "record_id": { "type": "string", "pattern": "^term:[a-z0-9][a-z0-9-]*$" },
    "entity_type": { "const": "term" },

    "title": { "type": "string", "minLength": 2, "maxLength": 300 },
    "term_type": {
      "type": "string",
      "enum": ["actor", "role", "system", "component", "event", "rule", "field", "external", "concept"]
    },
    "definition": { "type": "string", "minLength": 10, "maxLength": 2000 },

    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "responsible": { "type": ["string", "null"] },
    "source_path": { "type": "string", "pattern": "^glossary/[a-z0-9][a-z0-9-]*\\.md$" },

    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },

    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type_id", "target"],
        "properties": {
          "type_id": { "type": "string" },
          "target": {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "type": "string" } }
          }
        }
      }
    }
  }
}
