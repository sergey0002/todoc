{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "title",
    "past_tense_name",
    "producer",
    "payload_ref",
    "origin"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^event:[a-z0-9][a-z0-9-]*-v[0-9]+$"
    },
    "entity_type": {
      "const": "domain-event"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "past_tense_name": {
      "type": "string",
      "minLength": 3,
      "description": "Имя факта в прошедшем времени (OrderPlaced), не команда."
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payload_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Ссылка на схему payload в репо (repo:// или https)."
    },
    "command": {
      "type": [
        "string",
        "null"
      ],
      "description": "Какая команда запускается фактом (PlaceOrder) — отдельно от имени события."
    },
    "origin": {
      "type": "object",
      "properties": {
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type_id",
          "target"
        ],
        "properties": {
          "type_id": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
