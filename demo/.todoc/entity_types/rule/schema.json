{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "title",
    "statement",
    "examples",
    "status",
    "origin"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^rule:[a-z0-9][a-z0-9-]*-v[0-9]+$"
    },
    "entity_type": {
      "const": "rule"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "statement": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "description": "Проверяемая формулировка правила (контракт, не лозунг)."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "rejected"
      ]
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "given",
          "then"
        ],
        "properties": {
          "given": {
            "type": "string"
          },
          "when": {
            "type": "string"
          },
          "then": {
            "type": "string"
          }
        }
      },
      "description": "Примеры-тесты {given, when, then}; будущие fixture-тесты Фазы 4."
    },
    "origin": {
      "type": "object",
      "properties": {
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type_id",
          "target"
        ],
        "properties": {
          "type_id": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
