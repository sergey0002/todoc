{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "title",
    "kind",
    "criticality",
    "origin"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^dep:[a-z0-9][a-z0-9-]*$"
    },
    "entity_type": {
      "const": "dependency"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "kind": {
      "type": "string",
      "enum": [
        "service",
        "db",
        "api",
        "queue",
        "ext"
      ]
    },
    "criticality": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "origin": {
      "type": "object",
      "properties": {
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type_id",
          "target"
        ],
        "properties": {
          "type_id": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
