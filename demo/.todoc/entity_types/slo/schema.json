{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "title",
    "indicator",
    "target",
    "window",
    "origin"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^slo:[a-z0-9][a-z0-9-]*$"
    },
    "entity_type": {
      "const": "slo"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "indicator": {
      "type": "string",
      "minLength": 1,
      "description": "SLI: что измеряем (availability, latency p99)."
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "description": "Цель: ≥99.9% и т.п."
    },
    "window": {
      "type": "string",
      "minLength": 1,
      "description": "Окно измерения: rolling 30d и т.п."
    },
    "origin": {
      "type": "object",
      "properties": {
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type_id",
          "target"
        ],
        "properties": {
          "type_id": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
