{
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "title",
    "source_path",
    "doc_type"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^document:[a-z0-9][a-z0-9-]*$"
    },
    "entity_type": {
      "const": "document"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "doc_type": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "enum": [
        "ru",
        "en"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "origin": {
      "type": "string"
    },
    "relations": {
      "type": "array"
    }
  }
}
