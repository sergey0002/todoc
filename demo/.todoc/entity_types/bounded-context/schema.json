{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "title",
    "language",
    "owner"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^context:[a-z0-9][a-z0-9-]*$"
    },
    "entity_type": {
      "const": "bounded-context"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "language": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Ubiquitous terms контекста (заказ/платёж/шлюз)."
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "origin": {
      "type": "object",
      "properties": {
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type_id",
          "target"
        ],
        "properties": {
          "type_id": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
