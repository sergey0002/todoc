{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "record_id", "entity_type", "title"],
  "properties": {
    "schema_version": { "const": 1 },

    "record_id": { "type": "string", "pattern": "^task:[a-z0-9][a-z0-9-]*$" },
    "entity_type": { "const": "task" },

    "title": { "type": "string", "minLength": 3, "maxLength": 300 },

    "source": {
      "type": "string",
      "default": "user",
      "minLength": 1,
      "maxLength": 100,
      "description": "Откуда задача, свободный текст: user (по умолчанию — поставлена пользователем в чате), jira, telegram, email, звонок и т.п."
    },

    "status": { "type": ["string", "null"], "default": "open" },
    "stage": { "type": ["string", "null"] },
    "priority": { "type": ["string", "null"] },
    "assignee": { "type": ["string", "null"] },
    "created": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "due": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },

    "jira_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" },
    "issue_type": { "type": ["string", "null"] },
    "reporter": { "type": ["string", "null"] },
    "project_key": { "type": ["string", "null"] },
    "project_name": { "type": ["string", "null"] },
    "updated": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "story_points": { "type": ["number", "null"] },
    "labels": { "type": "array", "items": { "type": "string" } },
    "components": { "type": "array", "items": { "type": "string" } },
    "fix_versions": { "type": "array", "items": { "type": "string" } },
    "description": { "type": ["string", "null"] },
    "url": { "type": ["string", "null"], "pattern": "^https?://" },
    "fetched_at": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },

    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["author", "body"],
        "properties": {
          "author": { "type": "string" },
          "created": { "type": ["string", "null"] },
          "body": { "type": "string" }
        }
      }
    },

    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string", "pattern": "^attachments/" },
          "mime": { "type": ["string", "null"] },
          "size": { "type": ["number", "null"] },
          "url": { "type": ["string", "null"], "pattern": "^https?://" }
        }
      }
    },

    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "done": { "type": "boolean", "default": false }
        }
      }
    },

    "origin": {
      "type": "object",
      "properties": {
        "project": { "type": ["string", "null"] },
        "fetched_by": { "type": ["string", "null"] }
      }
    },

    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type_id", "target"],
        "properties": {
          "type_id": { "type": "string" },
          "target": {
            "type": "object",
            "required": ["id"],
            "properties": { "id": { "type": "string" } }
          }
        }
      }
    }
  }
}
