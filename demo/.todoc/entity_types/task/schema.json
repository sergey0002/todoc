{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "jira_key",
    "title",
    "status_at_fetch",
    "issue_type",
    "url",
    "fetched_at",
    "origin"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_id": { "type": "string", "pattern": "^task:[a-z0-9][a-z0-9-]*$" },
    "entity_type": { "const": "task" },
    "jira_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" },
    "title": { "type": "string", "minLength": 3 },
    "status_at_fetch": { "type": "string", "minLength": 2 },
    "issue_type": { "type": "string", "minLength": 2 },
    "priority": { "type": ["string", "null"] },
    "assignee": { "type": ["string", "null"] },
    "reporter": { "type": ["string", "null"] },
    "project_key": { "type": "string" },
    "project_name": { "type": "string" },
    "created": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "updated": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
    "due": { "type": ["string", "null"] },
    "story_points": { "type": ["number", "null"] },
    "labels": { "type": "array", "items": { "type": "string" } },
    "components": { "type": "array", "items": { "type": "string" } },
    "description": { "type": ["string", "null"] },
    "url": { "type": "string", "pattern": "^https?://" },
    "fetched_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["author", "created", "body"],
        "properties": {
          "author": { "type": "string" },
          "created": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string", "pattern": "^attachments/" },
          "mime": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"], "pattern": "^https?://" }
        }
      }
    },
    "origin": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "const": "jira" },
        "project": { "type": ["string", "null"] },
        "fetched_by": { "type": ["string", "null"] }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type_id", "target"],
        "properties": {
          "type_id": { "type": "string" },
          "target": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
