{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "record_id",
    "entity_type",
    "title",
    "method",
    "path",
    "auth",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "pattern": "^api-endpoint:[a-z0-9-]+:(get|post|put|patch|delete):[a-z0-9/_{}.-]+$"
    },
    "entity_type": {
      "const": "api-endpoint"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300
    },
    "method": {
      "type": "string",
      "enum": [
        "get",
        "post",
        "put",
        "patch",
        "delete"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "auth": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Требование аутентификации: none, api-key, oauth2, jwt, …"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "meaning": {
            "type": "string"
          }
        }
      }
    },
    "spec_url": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https?://|^repo://"
    },
    "origin": {
      "type": "object",
      "properties": {
        "task": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type_id",
          "target"
        ],
        "properties": {
          "type_id": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
